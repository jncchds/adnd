# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL password (used by both postgres service and app connection string)
POSTGRES_PASSWORD=change_me_secure_password

# ── Application ───────────────────────────────────────────────────────────────
# Host port the app listens on (mapped to container port 8080)
APP_PORT=5010

# ── JWT ───────────────────────────────────────────────────────────────────────
# SecretKey must be at least 32 characters
JWT_SECRET_KEY=change_me_jwt_secret_minimum_32_characters_long_xxx
JWT_ISSUER=adnd-server
JWT_AUDIENCE=adnd-client

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256-GCM master key for encrypting LLM API keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=change_me_base64_32_byte_key_generated_by_openssl

# ── LLM Resilience (optional, defaults shown) ─────────────────────────────────
RESILIENCE__RETRY_DELAY_MS=500
RESILIENCE__MAX_RETRIES=3
RESILIENCE__FAILURE_THRESHOLD=5
RESILIENCE__HALF_OPEN_DURATION_SECONDS=30

# ── Rate Limiting (optional, defaults shown) ──────────────────────────────────
RATE_LIMITING__GLOBAL_PERMIT_LIMIT=300
RATE_LIMITING__AUTH_PERMIT_LIMIT=20
RATE_LIMITING__LLM_PRESET_PERMIT_LIMIT=10

# ── Security (optional, defaults shown) ───────────────────────────────────────
# Allow LLM preset endpoints to point at private/LAN addresses. Self-hosted Ollama
# and LM Studio live there, so this defaults to true. Set false if untrusted users
# can register — otherwise "query models at this endpoint" is an SSRF primitive.
# The cloud metadata range (169.254.0.0/16) is always blocked either way.
SECURITY__ALLOW_PRIVATE_LLM_ENDPOINTS=true

# Serve Swagger UI. Defaults to Development only: it documents the whole API surface
# and cannot sit behind bearer auth, so it is not exposed in Production by default.
# SWAGGER__ENABLED=true

# Hangfire dashboard. Disabled by default — Hangfire's built-in "local requests only"
# check treats every request as local when a reverse proxy runs on the same host.
# HANGFIRE__DASHBOARD_ENABLED=true
# HANGFIRE__DASHBOARD_ALLOWED_IPS=localhost,10.0.0.5

# ── Logging (optional) ────────────────────────────────────────────────────────
LOGGING__LOG_LEVEL__MICROSOFT_ENTITY_FRAMEWORK_CORE=Warning

# ── LLM Debug Logging (optional) ──────────────────────────────────────────────
# Set to "true" to dump raw system prompt, user prompt, and response for every
# LLM interaction to container stdout. Useful for debugging model behaviour.
# Never enable in production — logs will contain full conversation content.
# LLM_DEBUG_LOG=true
