{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=adnd;Username=adnd;Password=adnd_secret"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION",
    "Issuer": "adnd-server",
    "Audience": "adnd-client"
  },
  "Encryption": {
    "MasterKey": "CHANGE_ME_TO_A_32_BYTE_MIN_KEY_FOR_AES256"
  },
  "Resilience": {
    "RetryDelayMs": 500,
    "MaxRetries": 3,
    "FailureThreshold": 5,
    "HalfOpenAfterSec": 30
  }
}
