{
  "JwtSettings": {
    "SecretKey": "OVERRIDE_IN_ENVIRONMENT",
    "Issuer": "adnd-server",
    "Audience": "adnd-client",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=adnd;Username=adnd;Password=adnd"
  },
  "Encryption": {
    "MasterKey": "OVERRIDE_IN_ENVIRONMENT"
  },
  "Resilience": {
    "RetryDelayMs": 500,
    "MaxRetries": 3,
    "FailureThreshold": 5,
    "HalfOpenDurationSeconds": 30
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "AuthPermitLimit": 10,
    "LLMPresetPermitLimit": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
